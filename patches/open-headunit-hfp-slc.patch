+package com.andrerinas.openheadunit.app
+
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class WirelessAdbBootContractTest {
+
+    @Test
+    fun manifestAndBootReceiverKeepWirelessAdbRecoveryWired() {
+        val workingDirectory = System.getProperty("user.dir")
+            ?: error("user.dir is unavailable")
+        val projectRoot = generateSequence(File(workingDirectory)) { it.parentFile }
+            .first { File(it, "app/src/main/AndroidManifest.xml").isFile }
+        val manifest = File(projectRoot, "app/src/main/AndroidManifest.xml").readText()
+        val receiver = File(
+            projectRoot,
+            "app/src/main/java/com/andrerinas/openheadunit/app/BootCompleteReceiver.kt"
+        ).readText()
+
+        assertTrue(manifest.contains("android.permission.WRITE_SECURE_SETTINGS"))
+        assertTrue(receiver.contains("restoreWirelessAdbIfAuthorized(context, action)"))
+        assertTrue(receiver.contains("ADB_WIFI_ENABLED"))
+        assertTrue(receiver.contains("AndroidSettings.Global.putInt"))
+    }
+}
