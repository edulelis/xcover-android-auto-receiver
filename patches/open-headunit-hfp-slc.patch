+package com.andrerinas.openheadunit.main
+
+import java.io.File
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HomeLayoutContractTest {
+
+    @Test
+    fun `every home layout variant exposes fragment bindings`() {
+        val requiredIds = listOf(
+            "self_mode_button",
+            "usb_button",
+            "settings_button",
+            "wifi_button",
+            "wifi_text",
+            "exit_button",
+            "self_mode_text",
+            "connection_badge",
+            "audio_route_text"
+        )
+
+        listOf(
+            "layout/fragment_home.xml",
+            "layout-port/fragment_home.xml"
+        ).forEach { relativePath ->
+            val layout = File("src/main/res/$relativePath")
+            assertTrue("Missing layout source: $layout", layout.isFile)
+            val xml = layout.readText()
+
+            requiredIds.forEach { id ->
+                assertTrue(
+                    "$relativePath must expose @$id for HomeFragment",
+                    xml.contains("@+id/$id")
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `dedicated home distinguishes active Android Auto from unavailable CarPlay`() {
+        val xml = File("src/main/res/layout/fragment_home.xml").readText()
+
+        assertTrue(xml.contains("@+id/platform_actions"))
+        assertTrue(xml.contains("@+id/carplay_card"))
+        assertTrue(xml.contains("android:enabled=\"false\""))
+        assertTrue(xml.contains("@drawable/ic_carplay_mark"))
+        assertTrue(xml.contains("@drawable/ic_android_auto_mark"))
+        assertTrue(xml.contains("@string/dedicated_home_platform_unavailable"))
+    }
+}
