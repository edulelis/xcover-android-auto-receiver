+package com.andrerinas.openheadunit.main
+
+import com.andrerinas.openheadunit.connection.CommManager
+
+internal enum class DedicatedHomeConnectionState {
+    READY,
+    CONNECTING,
+    CONNECTED
+}
+
+internal fun resolveDedicatedHomeConnectionState(
+    connectionState: CommManager.ConnectionState,
+    scanning: Boolean
+): DedicatedHomeConnectionState = when {
+    connectionState is CommManager.ConnectionState.TransportStarted ->
+        DedicatedHomeConnectionState.CONNECTED
+
+    scanning ||
+        connectionState is CommManager.ConnectionState.Connecting ||
+        connectionState is CommManager.ConnectionState.Connected ||
+        connectionState is CommManager.ConnectionState.StartingTransport ||
+        connectionState is CommManager.ConnectionState.HandshakeComplete ->
+        DedicatedHomeConnectionState.CONNECTING
+
+    else -> DedicatedHomeConnectionState.READY
+}
