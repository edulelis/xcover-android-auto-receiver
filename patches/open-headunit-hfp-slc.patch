--- /dev/null
+++ b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedGreenThemeContractTest.kt
@@ -0,0 +1,24 @@
+package com.andrerinas.openheadunit.main
+
+import java.io.File
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DedicatedGreenThemeContractTest {
+
+    @Test
+    fun `dedicated receiver uses the motorcycle olive palette throughout`() {
+        val colors = File("src/main/res/values/colors.xml").readText()
+        val home = File("src/main/res/layout/fragment_home.xml").readText()
+        val splash = File("src/main/res/drawable/splash_background.xml").readText()
+
+        assertTrue(colors.contains("<color name=\"tracer_accent\">#6D7B3E</color>"))
+        assertTrue(colors.contains("<color name=\"brand_teal\">#6D7B3E</color>"))
+        assertTrue(home.contains("app:tint=\"@color/tracer_accent\""))
+        assertTrue(home.contains("app:backgroundTint=\"@color/tracer_accent\""))
+        assertTrue(splash.contains("android:tint=\"@color/tracer_accent\""))
+        assertFalse(colors.contains("tracer_red"))
+        assertFalse(home.contains("tracer_red"))
+    }
+}
diff --git a/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedHomeUiStateTest.kt b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedHomeUiStateTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e693710b5b1e2bd98d02e5d4bae3f697aa7fc440
--- /dev/null
+++ b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedHomeUiStateTest.kt
@@ -0,0 +1,52 @@
+package com.andrerinas.openheadunit.main
+
+import com.andrerinas.openheadunit.connection.CommManager
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DedicatedHomeUiStateTest {
+
+    @Test
+    fun `disconnected is ready`() {
+        assertEquals(
+            DedicatedHomeConnectionState.READY,
+            resolveDedicatedHomeConnectionState(
+                CommManager.ConnectionState.Disconnected(),
+                scanning = false
+            )
+        )
+    }
+
+    @Test
+    fun `wireless scan is connecting`() {
+        assertEquals(
+            DedicatedHomeConnectionState.CONNECTING,
+            resolveDedicatedHomeConnectionState(
+                CommManager.ConnectionState.Disconnected(),
+                scanning = true
+            )
+        )
+    }
+
+    @Test
+    fun `handshake is connecting until transport starts`() {
+        assertEquals(
+            DedicatedHomeConnectionState.CONNECTING,
+            resolveDedicatedHomeConnectionState(
+                CommManager.ConnectionState.HandshakeComplete,
+                scanning = false
+            )
+        )
+    }
+
+    @Test
+    fun `started transport is connected`() {
+        assertEquals(
+            DedicatedHomeConnectionState.CONNECTED,
+            resolveDedicatedHomeConnectionState(
+                CommManager.ConnectionState.TransportStarted,
+                scanning = false
+            )
+        )
+    }
+}
