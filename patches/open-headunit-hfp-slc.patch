+    @Test
+    fun `parses audio gateway features from fragmented HFP response`() {
+        val response = "\r\n+BRSF: 1024\r\n\r\nOK\r\n"
+
+        assertEquals(1024, NativeAaHandshakeManager.parseHfpAgFeatures(response))
+        assertEquals(true, NativeAaHandshakeManager.hfpTerminalResponse(response))
+    }
+
+    @Test
+    fun `SLC uses mandatory command order without codec negotiation`() {
+        assertEquals(
+            listOf("AT+CIND=?", "AT+CIND?", "AT+CMER=3,0,0,1"),
+            NativeAaHandshakeManager.hfpSlcFollowUpCommands(0)
+        )
+    }
+
+    @Test
+    fun `SLC adds BAC when hands-free and audio gateway negotiate codecs`() {
+        assertEquals(
+            listOf("AT+BAC=1,2", "AT+CIND=?", "AT+CIND?", "AT+CMER=3,0,0,1"),
+            NativeAaHandshakeManager.hfpSlcFollowUpCommands(1 shl 9)
+        )
+    }
+
+    @Test
+    fun `HFP terminal parser distinguishes error from incomplete response`() {
+        assertEquals(false, NativeAaHandshakeManager.hfpTerminalResponse("\r\nERROR\r\n"))
+        assertEquals(null, NativeAaHandshakeManager.hfpTerminalResponse("\r\n+CIND: 1,0"))
+    }
 }
diff --git a/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedGreenThemeContractTest.kt b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedGreenThemeContractTest.kt
