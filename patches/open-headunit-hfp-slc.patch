@@ -0,0 +1,28 @@
+package com.andrerinas.openheadunit.connection
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class NativeAaToastContractTest {
+
+    @Test
+    fun nativeGroupDiagnosticsStayInLogsInsteadOfCoveringTheHud() {
+        val workingDirectory = System.getProperty("user.dir")
+            ?: error("user.dir is unavailable")
+        val projectRoot = generateSequence(File(workingDirectory)) { it.parentFile }
+            .first { File(it, "app/src/main/AndroidManifest.xml").isFile }
+        val source = File(
+            projectRoot,
+            "app/src/main/java/com/andrerinas/openheadunit/connection/WifiDirectManager.kt"
+        ).readText()
+        val statusMethod = source
+            .substringAfter("private fun notifyNativeGroupStarted")
+            .substringBefore("private fun showToast")
+
+        assertFalse(statusMethod.contains("showToast("))
+        assertFalse(source.contains("showToast(\"Native AA WiFi Direct started"))
+        assertTrue(source.contains("showToast(\"Native AA requires Wi-Fi"))
+    }
+}
