+package com.andrerinas.openheadunit.main
+
+import java.io.File
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class UnpluggedPowerPolicyContractTest {
+
+    @Test
+    fun `head unit does not override Android screen timeout after external power is removed`() {
+        val systemUi = File(
+            "src/main/java/com/andrerinas/openheadunit/utils/SystemUI.kt"
+        ).readText()
+        val settings = File(
+            "src/main/java/com/andrerinas/openheadunit/utils/Settings.kt"
+        ).readText()
+
+        assertFalse(systemUi.contains("addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)"))
+        assertTrue(systemUi.contains("clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)"))
+        assertFalse(settings.contains("prefs.getBoolean(\"auto-start-on-screen-on\", true)"))
+        assertFalse(settings.contains("prefs.getBoolean(KEY_AUTO_START_ON_SCREEN_ON, true)"))
+    }
+}
