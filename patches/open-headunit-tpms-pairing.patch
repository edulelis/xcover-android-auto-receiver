+    private fun renderTpmsAlerts(state: TpmsState) {
+        val alerts = TpmsAlertEvaluator.evaluateAll(
+            state = state,
+            nowElapsedMs = SystemClock.elapsedRealtime(),
+        )
+        val activeKeys = alerts.mapTo(mutableSetOf(), TpmsAlert::acknowledgementKey)
+        acknowledgedTpmsAlerts.retainAll(activeKeys)
+
+        // A short simulation is intentionally stable and cannot be replaced by an incoming
+        // packet. The live state is restored as soon as the simulation closes.
+        if (visibleTpmsAlert?.isSimulation == true) return
+
+        val nextAlert = alerts.firstOrNull {
+            it.acknowledgementKey !in acknowledgedTpmsAlerts
+        }
+        if (nextAlert == null) {
+            if (visibleTpmsAlert?.isSimulation != true) hideTpmsAlert()
+            return
+        }
+
+        if (visibleTpmsAlert?.acknowledgementKey == nextAlert.acknowledgementKey) {
+            bindTpmsAlert(nextAlert, announce = false)
+        } else {
+            showTpmsAlert(nextAlert)
+        }
+    }
+
+    private fun showTpmsAlert(alert: TpmsAlert) {
