index 0000000000000000000000000000000000000000..593939d0c49c13218872182f8644495b919d6d09
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/main/TouchLockOverlay.kt
@@ -0,0 +1,63 @@
+package com.andrerinas.openheadunit.main
+
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.lifecycleScope
+import androidx.lifecycle.repeatOnLifecycle
+import com.andrerinas.openheadunit.R
+import kotlinx.coroutines.launch
+
+/** Installs the topmost touch-consuming layer used by [TouchLockController]. */
+object TouchLockOverlay {
+    fun install(activity: AppCompatActivity) {
+        val content = activity.findViewById<ViewGroup>(android.R.id.content) ?: return
+        if (content.findViewById<View>(R.id.touch_lock_overlay) != null) return
+
+        val overlay = LayoutInflater.from(activity)
+            .inflate(R.layout.view_touch_lock_overlay, content, false)
+        val releasedIndicator = LayoutInflater.from(activity)
+            .inflate(R.layout.view_touch_lock_released_indicator, content, false)
+        overlay.setOnTouchListener { _, _ -> true }
+        content.addView(
+            overlay,
+            ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT,
+            ),
+        )
+        content.addView(releasedIndicator)
+        val hideReleasedIndicator = Runnable {
+            releasedIndicator.visibility = View.GONE
+        }
+
+        activity.lifecycleScope.launch {
+            activity.lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                var previousLocked: Boolean? = null
+                TouchLockController.locked.collect { locked ->
+                    overlay.visibility = if (locked) View.VISIBLE else View.GONE
+                    if (locked) {
+                        releasedIndicator.removeCallbacks(hideReleasedIndicator)
+                        releasedIndicator.visibility = View.GONE
+                        overlay.announceForAccessibility(
+                            activity.getString(R.string.touch_lock_accessibility),
+                        )
+                    } else if (previousLocked == true) {
+                        releasedIndicator.bringToFront()
+                        releasedIndicator.visibility = View.VISIBLE
+                        releasedIndicator.announceForAccessibility(
+                            activity.getString(R.string.touch_lock_released_accessibility),
+                        )
+                        releasedIndicator.removeCallbacks(hideReleasedIndicator)
+                        releasedIndicator.postDelayed(hideReleasedIndicator, RELEASE_CONFIRMATION_MS)
+                    }
+                    previousLocked = locked
+                }
+            }
+        }
+    }
+
+    private const val RELEASE_CONFIRMATION_MS = 1_200L
+}
