+package com.andrerinas.openheadunit.tpms
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TpmsLocaleContractTest {
+    private val requiredAlertStrings = listOf(
+        "tpms_alert_test_badge",
+        "tpms_alert_front",
+        "tpms_alert_rear",
+        "tpms_alert_low_pressure",
+        "tpms_alert_high_pressure",
+        "tpms_alert_high_temperature",
+        "tpms_alert_pressure_value",
+        "tpms_alert_temperature_value",
+        "tpms_alert_dismiss",
+    )
+
+    @Test
+    fun `every translated locale owns the complete TPMS alert vocabulary`() {
+        val localeFiles = File("src/main/res")
+            .listFiles()
+            .orEmpty()
+            .filter { it.isDirectory && it.name.startsWith("values-") }
+            .map { File(it, "strings.xml") }
+            .filter(File::isFile)
+
+        assertEquals(19, localeFiles.size)
+        localeFiles.forEach { file ->
+            val xml = file.readText()
+            requiredAlertStrings.forEach { key ->
+                assertTrue(
+                    "${file.parentFile?.name.orEmpty()} is missing $key",
+                    xml.contains("name=\"$key\""),
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `system language remains the default app language`() {
+        val settings = File(
+            "src/main/java/com/andrerinas/openheadunit/utils/Settings.kt"
+        ).readText()
+        val localeHelper = File(
+            "src/main/java/com/andrerinas/openheadunit/utils/LocaleHelper.kt"
+        ).readText()
+
+        assertTrue(settings.contains("prefs.getString(\"app-language\", \"\")"))
+        assertTrue(localeHelper.contains("const val SYSTEM_DEFAULT = \"\""))
+        assertTrue(localeHelper.contains("if (localeString.isEmpty())"))
+    }
+}
