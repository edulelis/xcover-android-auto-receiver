+package com.andrerinas.openheadunit.tpms
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TpmsAdvertisementDecoderTest {
+    @Test
+    fun `parses and decodes documented BR 27A5 advertisement`() {
+        val raw = hex("0303A5270308425208FF281D130105A376")
+
+        val parsed = TpmsAdvertisementDecoder.parse(raw)
+        val reading = TpmsAdvertisementDecoder.decode(parsed)
+
+        assertEquals("BR", parsed.advertisedName)
+        assertEquals(setOf(0x27A5), parsed.serviceUuids16)
+        assertArrayEquals(hex("281D130105A376"), parsed.manufacturerData.single())
+        requireNotNull(reading)
+        assertEquals(TpmsProtocol.BR_27A5, reading.protocol)
+        assertEquals(11.6, reading.pressurePsi, 0.001)
+        assertEquals(0.800, reading.pressureBar, 0.001)
+        assertEquals(19, reading.temperatureC)
+        assertEquals(2.9, reading.batteryVolts ?: 0.0, 0.001)
+        assertEquals(0x28, reading.status)
+    }
+
+    @Test
+    fun `preserves signed below-zero temperature`() {
+        val raw = hex("0303A5270308425208FF001EE201F90000")
+
+        val reading = TpmsAdvertisementDecoder.decode(
+            TpmsAdvertisementDecoder.parse(raw)
+        )
+
+        requireNotNull(reading)
+        assertEquals(-30, reading.temperatureC)
+        assertEquals(36.0, reading.pressurePsi, 0.001)
+    }
+
+    @Test
+    fun `does not treat an unrelated seven-byte manufacturer packet as a pairing candidate`() {
+        val raw = hex("08FF281D130105A376")
+        val parsed = TpmsAdvertisementDecoder.parse(raw)
+
+        assertNull(TpmsAdvertisementDecoder.decode(parsed))
+        assertFalse(TpmsAdvertisementDecoder.isLikelyTpms(parsed, rssi = -50))
+    }
+
+    @Test
+    fun `identifies the static MotorCare automatic-bind advertisement without Android pairing`() {
+        // Shape recovered from a static inspection of MotorCare 1.3.0. The vendor checks the
+        // front marker at raw hex 22..23 and the six-digit sensor identifier at 28..33.
+        val raw = hex("0201060EFF0100AABBCCDD80EE99ABCDEFFF0C0954504D5331414243444546")
+
+        val identity = TpmsAdvertisementDecoder.pairingIdentity(
+            TpmsAdvertisementDecoder.parse(raw)
+        )
+
+        requireNotNull(identity)
+        assertEquals(TpmsProtocol.MOTORCARE_TPMS, identity.protocol)
+        assertEquals("ABCDEF", identity.sensorId)
+        assertEquals(TirePosition.FRONT, identity.indicatedPosition)
+    }
+
+    @Test
+    fun `rejects a MotorCare name when its wheel marker disagrees`() {
+        val raw = hex("0201060EFF0100AABBCCDD81EE99ABCDEFFF0C0954504D5331414243444546")
+
+        assertNull(
+            TpmsAdvertisementDecoder.pairingIdentity(
+                TpmsAdvertisementDecoder.parse(raw)
+            )
+        )
+    }
+
+    @Test
+    fun `stops safely at a truncated advertising structure`() {
+        val parsed = TpmsAdvertisementDecoder.parse(hex("0AFF0102"))
+
+        assertTrue(parsed.manufacturerData.isEmpty())
+        assertNull(TpmsAdvertisementDecoder.decode(parsed))
+    }
+
+    private fun hex(value: String): ByteArray = value.chunked(2)
+        .map { it.toInt(16).toByte() }
+        .toByteArray()
+}
