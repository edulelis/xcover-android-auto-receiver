+package com.andrerinas.openheadunit.main
+
+import android.bluetooth.BluetoothAdapter
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.provider.Settings
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.ProgressBar
+import android.widget.TextView
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.fragment.app.Fragment
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.lifecycleScope
+import androidx.lifecycle.repeatOnLifecycle
+import androidx.navigation.fragment.findNavController
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.andrerinas.openheadunit.App
+import com.andrerinas.openheadunit.R
+import com.andrerinas.openheadunit.tpms.TirePosition
+import com.andrerinas.openheadunit.tpms.TpmsAssignments
+import com.andrerinas.openheadunit.tpms.TpmsCandidate
+import com.andrerinas.openheadunit.tpms.TpmsScanError
+import com.andrerinas.openheadunit.tpms.TpmsState
+import com.andrerinas.openheadunit.utils.AppLog
+import com.google.android.material.appbar.MaterialToolbar
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import kotlinx.coroutines.launch
+
+class TpmsPairingFragment : Fragment() {
+    private val repository get() = App.provide(requireContext()).tpmsRepository
+
+    private lateinit var adapter: TpmsCandidateAdapter
+    private lateinit var progressSummary: TextView
+    private lateinit var frontSlot: View
+    private lateinit var rearSlot: View
+    private lateinit var frontAssignment: TextView
+    private lateinit var rearAssignment: TextView
+    private lateinit var stepEyebrow: TextView
+    private lateinit var stepTitle: TextView
+    private lateinit var stepInstruction: TextView
+    private lateinit var scanBar: View
+    private lateinit var scanProgress: ProgressBar
+    private lateinit var scanStatus: TextView
+    private lateinit var scanButton: Button
+    private lateinit var statePanel: View
+    private lateinit var stateIconBackground: FrameLayout
+    private lateinit var stateIcon: ImageView
+    private lateinit var stateTitle: TextView
+    private lateinit var stateBody: TextView
+    private lateinit var candidateList: RecyclerView
+    private lateinit var removeButton: Button
+    private lateinit var cancelReplaceButton: Button
+    private lateinit var doneButton: Button
+
+    private var activeTarget: TirePosition? = null
+    private var replacing = false
+    private var permissionDeniedThisVisit = false
+    private var previousCandidateCount = 0
+
+    private val permissionLauncher = registerForActivityResult(
+        ActivityResultContracts.RequestMultiplePermissions()
+    ) { grants ->
+        if (grants.values.all { it } && repository.hasScanPermission()) {
+            permissionDeniedThisVisit = false
+            activeTarget?.let { repository.startScan(pairingMode = true, pairingTarget = it) }
+        } else {
+            permissionDeniedThisVisit = true
+            // Publish a persistent, actionable error instead of relying on a transient toast.
+            activeTarget?.let { repository.startScan(pairingMode = true, pairingTarget = it) }
+        }
+    }
+
+    private val bluetoothLauncher = registerForActivityResult(
+        ActivityResultContracts.StartActivityForResult()
+    ) {
+        requestPermissionAndScan()
+    }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View = inflater.inflate(R.layout.fragment_tpms_pairing, container, false)
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+
+        view.findViewById<MaterialToolbar>(R.id.tpms_toolbar).setNavigationOnClickListener {
+            findNavController().popBackStack()
+        }
+        progressSummary = view.findViewById(R.id.tpms_progress_summary)
+        frontSlot = view.findViewById(R.id.tpms_front_slot)
+        rearSlot = view.findViewById(R.id.tpms_rear_slot)
+        frontAssignment = view.findViewById(R.id.tpms_front_assignment)
+        rearAssignment = view.findViewById(R.id.tpms_rear_assignment)
+        stepEyebrow = view.findViewById(R.id.tpms_step_eyebrow)
+        stepTitle = view.findViewById(R.id.tpms_step_title)
+        stepInstruction = view.findViewById(R.id.tpms_step_instruction)
+        scanBar = view.findViewById(R.id.tpms_scan_bar)
+        scanProgress = view.findViewById(R.id.tpms_scan_progress)
+        scanStatus = view.findViewById(R.id.tpms_scan_status)
+        scanButton = view.findViewById(R.id.tpms_scan_button)
+        statePanel = view.findViewById(R.id.tpms_state_panel)
+        stateIconBackground = view.findViewById(R.id.tpms_state_icon_background)
+        stateIcon = view.findViewById(R.id.tpms_state_icon)
+        stateTitle = view.findViewById(R.id.tpms_state_title)
+        stateBody = view.findViewById(R.id.tpms_state_body)
+        candidateList = view.findViewById(R.id.tpms_candidate_list)
+        removeButton = view.findViewById(R.id.tpms_remove_button)
+        cancelReplaceButton = view.findViewById(R.id.tpms_cancel_replace_button)
+        doneButton = view.findViewById(R.id.tpms_done_button)
+
+        activeTarget = repository.state.value.assignments.firstMissingPosition()
+        adapter = TpmsCandidateAdapter(::selectCandidate)
+        candidateList.layoutManager = LinearLayoutManager(requireContext())
+        candidateList.adapter = adapter
+
+        frontSlot.setOnClickListener { selectWheel(TirePosition.FRONT) }
+        rearSlot.setOnClickListener { selectWheel(TirePosition.REAR) }
+        scanButton.setOnClickListener { handleScanAction() }
+        removeButton.setOnClickListener { activeTarget?.let(::confirmRemove) }
+        cancelReplaceButton.setOnClickListener { cancelReplacement() }
+        doneButton.setOnClickListener { findNavController().popBackStack() }
+
+        viewLifecycleOwner.lifecycleScope.launch {
+            viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                repository.state.collect(::render)
+            }
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // Opening setup must not begin a broad scan or surface a permission request. A capture
+        // starts only when the rider deliberately presses the action for one wheel.
+        repository.stopScan()
+    }
+
+    override fun onPause() {
+        repository.stopScan()
+        super.onPause()
+    }
+
+    private fun selectWheel(position: TirePosition) {
+        val assignments = repository.state.value.assignments
+        val assigned = assignments.deviceIdFor(position) != null
+        if (activeTarget == position && replacing == assigned) return
+
+        activeTarget = position
+        replacing = assigned
+        previousCandidateCount = 0
+        repository.stopScan()
+        repository.clearPairingCandidates()
+        render(repository.state.value)
+    }
+
+    private fun selectCandidate(candidate: TpmsCandidate) {
+        val target = activeTarget ?: return
+        val currentId = repository.state.value.assignments.deviceIdFor(target)
+        if (replacing && currentId != null && currentId != candidate.deviceId) {
+            val shortId = shortId(candidate.deviceId)
+            MaterialAlertDialogBuilder(requireContext())
+                .setTitle(
+                    if (target == TirePosition.FRONT) {
+                        R.string.tpms_replace_front_title
+                    } else {
+                        R.string.tpms_replace_rear_title
+                    }
+                )
+                .setMessage(
+                    getString(
+                        if (target == TirePosition.FRONT) {
+                            R.string.tpms_replace_front_confirmation
+                        } else {
+                            R.string.tpms_replace_rear_confirmation
+                        },
+                        shortId,
+                    )
+                )
+                .setNegativeButton(R.string.tpms_cancel, null)
+                .setPositiveButton(R.string.tpms_replace) { _, _ ->
+                    commitAssignment(target, candidate)
+                }
+                .show()
+        } else {
+            commitAssignment(target, candidate)
+        }
+    }
+
+    private fun commitAssignment(position: TirePosition, candidate: TpmsCandidate) {
+        // Deliberately omit the Bluetooth address. The advertisement itself is retained only
+        // after explicit selection so an undocumented MotorCare packet can be decoded later.
+        AppLog.i(
+            "TPMS selected candidate: protocol=${candidate.protocol}, " +
+                "name=${candidate.advertisedName ?: "unknown"}, " +
+                "services=${candidate.serviceUuids.joinToString { "0x%04X".format(it) }}, " +
+                "manufacturerLengths=${candidate.manufacturerDataLengths}, " +
+                "advertisement=${candidate.rawAdvertisementHex}"
+        )
+        repository.assign(position, candidate.deviceId)
+        val announcement = getString(
+            if (position == TirePosition.FRONT) {
+                R.string.tpms_assignment_saved_front
+            } else {
+                R.string.tpms_assignment_saved_rear
+            }
+        )
+        view?.announceForAccessibility(announcement)
+
+        replacing = false
+        activeTarget = repository.state.value.assignments.firstMissingPosition()
+        previousCandidateCount = 0
+        repository.stopScan()
+        repository.clearPairingCandidates()
+        render(repository.state.value)
+    }
+
+    private fun cancelReplacement() {
+        replacing = false
+        activeTarget = repository.state.value.assignments.firstMissingPosition()
+        previousCandidateCount = 0
+        repository.stopScan()
+        repository.clearPairingCandidates()
+        render(repository.state.value)
+    }
+
+    private fun confirmRemove(position: TirePosition) {
+        MaterialAlertDialogBuilder(requireContext())
+            .setTitle(
+                if (position == TirePosition.FRONT) {
+                    R.string.tpms_remove_front_title
+                } else {
+                    R.string.tpms_remove_rear_title
+                }
+            )
+            .setMessage(R.string.tpms_remove_explanation)
+            .setNegativeButton(R.string.tpms_cancel, null)
+            .setPositiveButton(R.string.tpms_remove) { _, _ ->
+                repository.clear(position)
+                replacing = false
+                activeTarget = position
+                previousCandidateCount = 0
+                repository.stopScan()
+                repository.clearPairingCandidates()
+                render(repository.state.value)
+            }
+            .show()
+    }
+
+    private fun handleScanAction() {
+        val state = repository.state.value
+        when (state.scanError) {
+            TpmsScanError.PERMISSION_REQUIRED -> {
+                if (permissionDeniedThisVisit) openAppSettings()
+                else requestPermissionAndScan()
+            }
+
+            TpmsScanError.BLUETOOTH_DISABLED -> bluetoothLauncher.launch(
+                Intent(BluetoothAdapter.ACTION_REQUEST_ENABLE)
+            )
+
+            TpmsScanError.BLE_UNSUPPORTED -> Unit
+            TpmsScanError.SCAN_FAILED -> requestPermissionAndScan()
+            null -> if (state.scanning) repository.stopScan()
+            else requestPermissionAndScan()
+        }
+    }
+
+    private fun requestPermissionAndScan() {
+        val target = activeTarget ?: return
+        if (repository.hasScanPermission()) {
+            repository.startScan(pairingMode = true, pairingTarget = target)
+            return
+        }
+        permissionLauncher.launch(repository.requiredPermissions())
+    }
+
+    private fun openAppSettings() {
+        startActivity(
+            Intent(
+                Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+                Uri.parse("package:${requireContext().packageName}"),
+            )
+        )
+    }
+
+    private fun render(state: TpmsState) {
+        renderProgress(state.assignments)
+        renderSlot(frontSlot, frontAssignment, state.assignments, TirePosition.FRONT)
+        renderSlot(rearSlot, rearAssignment, state.assignments, TirePosition.REAR)
+
+        val complete = state.assignments.isComplete && activeTarget == null
+        val target = activeTarget
+        if (complete) renderCompleteHeader()
+        else if (target != null) renderTargetHeader(target)
+
+        scanBar.visibility = if (complete) View.GONE else View.VISIBLE
+        scanProgress.visibility = if (state.scanning) View.VISIBLE else View.INVISIBLE
+        renderScanAction(state)
+
+        adapter.submit(state.candidates, state.assignments, target)
+        val showCandidates = !complete && state.scanError == null && state.candidates.isNotEmpty()
+        candidateList.visibility = if (showCandidates) View.VISIBLE else View.GONE
+        statePanel.visibility = if (showCandidates) View.GONE else View.VISIBLE
+        renderStatePanel(state, complete, target)
+
+        val firstResults = previousCandidateCount == 0 && state.candidates.isNotEmpty()
+        if (firstResults && target != null) {
+            candidateList.announceForAccessibility(
+                resources.getQuantityString(
+                    R.plurals.tpms_candidates_found,
+                    state.candidates.size,
+                    state.candidates.size,
+                )
+            )
+        }
+        previousCandidateCount = state.candidates.size
+
+        doneButton.visibility = if (complete) View.VISIBLE else View.GONE
+        removeButton.visibility = if (replacing) View.VISIBLE else View.GONE
+        cancelReplaceButton.visibility = if (replacing) View.VISIBLE else View.GONE
+    }
+
+    private fun renderProgress(assignments: TpmsAssignments) {
+        val count = listOf(assignments.frontDeviceId, assignments.rearDeviceId).count { it != null }
+        progressSummary.setText(
+            when (count) {
+                0 -> R.string.tpms_progress_empty
+                1 -> R.string.tpms_progress_partial
+                else -> R.string.tpms_progress_complete
+            }
+        )
+    }
+
+    private fun renderSlot(
+        slot: View,
+        assignment: TextView,
+        assignments: TpmsAssignments,
+        position: TirePosition,
+    ) {
+        val id = assignments.deviceIdFor(position)
+        val active = activeTarget == position
+        slot.isSelected = active
+        slot.isActivated = id != null && !active
+        assignment.text = when {
+            id != null -> getString(R.string.tpms_status_ready, shortId(id))
+            active -> getString(R.string.tpms_status_active)
+            else -> getString(R.string.tpms_status_pending)
+        }
+        val wheel = getString(
+            if (position == TirePosition.FRONT) {
+                R.string.dedicated_home_tpms_front
+            } else {
+                R.string.dedicated_home_tpms_rear
+            }
+        ).lowercase()
+        slot.contentDescription = when {
+            id != null -> getString(
+                R.string.tpms_slot_ready_accessibility,
+                wheel,
+                shortId(id),
+            )
+            active -> getString(R.string.tpms_slot_active_accessibility, wheel)
+            else -> getString(R.string.tpms_slot_pending_accessibility, wheel)
+        }
+    }
+
+    private fun renderTargetHeader(target: TirePosition) {
+        val front = target == TirePosition.FRONT
+        stepEyebrow.setText(
+            when {
+                replacing && front -> R.string.tpms_step_replace_front
+                replacing -> R.string.tpms_step_replace_rear
+                front -> R.string.tpms_step_front
+                else -> R.string.tpms_step_rear
+            }
+        )
+        stepTitle.setText(
+            when {
+                replacing && front -> R.string.tpms_replace_front_title
+                replacing -> R.string.tpms_replace_rear_title
+                front -> R.string.tpms_configure_front_title
+                else -> R.string.tpms_configure_rear_title
+            }
+        )
+        stepInstruction.setText(
+            if (replacing) R.string.tpms_replace_instruction else R.string.tpms_active_instruction
+        )
+    }
+
+    private fun renderCompleteHeader() {
+        stepEyebrow.setText(R.string.tpms_step_complete)
+        stepTitle.setText(R.string.tpms_ready_title)
+        stepInstruction.setText(R.string.tpms_ready_instruction)
+    }
+
+    private fun renderScanAction(state: TpmsState) {
+        scanButton.visibility = View.VISIBLE
+        scanStatus.setText(
+            when {
+                state.scanError != null -> errorTitle(state.scanError)
+                state.scanning -> R.string.tpms_capture_listening
+                state.candidates.isNotEmpty() -> R.string.tpms_capture_finished
+                else -> R.string.tpms_capture_ready
+            }
+        )
+        scanButton.setText(
+            when (state.scanError) {
+                TpmsScanError.PERMISSION_REQUIRED -> if (permissionDeniedThisVisit) {
+                    R.string.tpms_settings_action
+                } else {
+                    R.string.tpms_permission_action
+                }
+                TpmsScanError.BLUETOOTH_DISABLED -> R.string.tpms_bluetooth_action
+                TpmsScanError.BLE_UNSUPPORTED -> {
+                    scanButton.visibility = View.GONE
+                    R.string.tpms_retry
+                }
+                TpmsScanError.SCAN_FAILED -> R.string.tpms_retry
+                null -> if (state.scanning) R.string.tpms_stop_scan else R.string.tpms_start_scan
+            }
+        )
+    }
+
+    private fun renderStatePanel(
+        state: TpmsState,
+        complete: Boolean,
+        target: TirePosition?,
+    ) {
+        stateIconBackground.visibility = if (complete || state.scanError != null) {
+            View.VISIBLE
+        } else {
+            View.GONE
+        }
+        if (complete) {
+            stateIcon.setImageResource(R.drawable.ic_check)
+            stateTitle.setText(R.string.tpms_ready_title)
+            stateBody.setText(R.string.tpms_ready_body)
+            return
+        }
+        if (state.scanError != null) {
+            stateIcon.setImageResource(R.drawable.ic_warning_white)
+            stateTitle.setText(errorTitle(state.scanError))
+            stateBody.setText(errorBody(state.scanError))
+            return
+        }
+        stateTitle.setText(
+            if (state.scanning) R.string.tpms_waiting_title else R.string.tpms_empty_title
+        )
+        stateBody.setText(
+            when {
+                !state.scanning -> R.string.tpms_empty_stopped_body
+                target == TirePosition.REAR -> R.string.tpms_empty_rear_body
+                else -> R.string.tpms_empty_front_body
+            }
+        )
+    }
+
+    private fun errorTitle(error: TpmsScanError): Int = when (error) {
+        TpmsScanError.PERMISSION_REQUIRED -> if (permissionDeniedThisVisit) {
+            R.string.tpms_permission_denied_title
+        } else {
+            R.string.tpms_permission_title
+        }
+        TpmsScanError.BLUETOOTH_DISABLED -> R.string.tpms_bluetooth_title
+        TpmsScanError.BLE_UNSUPPORTED -> R.string.tpms_ble_unsupported_title
+        TpmsScanError.SCAN_FAILED -> R.string.tpms_scan_failed_title
+    }
+
+    private fun errorBody(error: TpmsScanError): Int = when (error) {
+        TpmsScanError.PERMISSION_REQUIRED -> if (permissionDeniedThisVisit) {
+            R.string.tpms_permission_denied
+        } else {
+            R.string.tpms_permission_required
+        }
+        TpmsScanError.BLUETOOTH_DISABLED -> R.string.tpms_bluetooth_disabled
+        TpmsScanError.BLE_UNSUPPORTED -> R.string.tpms_ble_unsupported
+        TpmsScanError.SCAN_FAILED -> R.string.tpms_scan_failed
+    }
+
+    private fun shortId(deviceId: String): String = deviceId
+        .filter(Char::isLetterOrDigit)
+        .takeLast(4)
+        .uppercase()
+}
diff --git a/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAdvertisementDecoder.kt b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAdvertisementDecoder.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e21520cd3d30faa32ccd5ac5e5ee9e3c5108efef
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAdvertisementDecoder.kt
@@ -0,0 +1,180 @@
+package com.andrerinas.openheadunit.tpms
+
+import java.nio.charset.Charset
+import kotlin.math.roundToInt
+
+data class ParsedBleAdvertisement(
+    val advertisedName: String?,
+    val serviceUuids16: Set<Int>,
+    val manufacturerData: List<ByteArray>,
+    val rawHex: String,
+)
+
+object TpmsAdvertisementDecoder {
+    private const val BR_SERVICE_UUID = 0x27A5
+    private const val PSI_TO_BAR = 0.0689475729
+    private const val MOTORCARE_FRONT_FRAME_TYPE = 80
+    private const val MOTORCARE_REAR_FRAME_TYPE = 81
+    private const val MOTORCARE_FRAME_TYPE_OFFSET = 22
+    private const val MOTORCARE_SENSOR_ID_OFFSET = 28
+    private const val MOTORCARE_SENSOR_ID_LENGTH = 6
+    private val utf8: Charset = Charsets.UTF_8
+
+    /**
+     * Parses the raw bytes returned by Android's ScanRecord. Parsing AD structures ourselves
+     * deliberately preserves the complete manufacturer payload: Android otherwise consumes the
+     * first two bytes as a company id, while this TPMS family uses all seven bytes as sensor data.
+     */
+    fun parse(raw: ByteArray): ParsedBleAdvertisement {
+        var offset = 0
+        var name: String? = null
+        val serviceUuids = linkedSetOf<Int>()
+        val manufacturerData = mutableListOf<ByteArray>()
+
+        while (offset < raw.size) {
+            val length = raw[offset].toInt() and 0xFF
+            if (length == 0) break
+
+            val structureEndExclusive = offset + 1 + length
+            if (length < 1 || structureEndExclusive > raw.size) break
+
+            val type = raw[offset + 1].toInt() and 0xFF
+            val dataStart = offset + 2
+            val dataEnd = structureEndExclusive
+            when (type) {
+                0x02, 0x03 -> {
+                    var uuidOffset = dataStart
+                    while (uuidOffset + 1 < dataEnd) {
+                        val uuid = (raw[uuidOffset].toInt() and 0xFF) or
+                            ((raw[uuidOffset + 1].toInt() and 0xFF) shl 8)
+                        serviceUuids += uuid
+                        uuidOffset += 2
+                    }
+                }
+
+                0x08, 0x09 -> {
+                    name = raw.copyOfRange(dataStart, dataEnd)
+                        .toString(utf8)
+                        .trimEnd('\u0000')
+                        .takeIf { it.isNotBlank() }
+                }
+
+                0xFF -> manufacturerData += raw.copyOfRange(dataStart, dataEnd)
+            }
+
+            offset = structureEndExclusive
+        }
+
+        return ParsedBleAdvertisement(
+            advertisedName = name,
+            serviceUuids16 = serviceUuids,
+            manufacturerData = manufacturerData,
+            rawHex = raw.toHex(),
+        )
+    }
+
+    /**
+     * Decoder for the documented BR / service 0x27A5 sensor family.
+     * Manufacturer payload: status, battery (0.1 V), signed temperature (C),
+     * big-endian encoded pressure, two checksum bytes. Pressure is (raw - 145) / 10 psi.
+     */
+    fun decode(parsed: ParsedBleAdvertisement): TpmsDecodedReading? {
+        val identifiesKnownFamily =
+            parsed.advertisedName.equals("BR", ignoreCase = true) ||
+                BR_SERVICE_UUID in parsed.serviceUuids16
+        if (!identifiesKnownFamily) return null
+
+        val payload = parsed.manufacturerData.firstOrNull { it.size == 7 } ?: return null
+        val status = payload[0].toInt() and 0xFF
+        val batteryVolts = (payload[1].toInt() and 0xFF) / 10.0
+        val temperatureC = payload[2].toInt()
+        val encodedPressure = ((payload[3].toInt() and 0xFF) shl 8) or
+            (payload[4].toInt() and 0xFF)
+        val pressurePsi = (encodedPressure - 145) / 10.0
+
+        // Reject accidental matches before they enter the pairing UI. These limits encompass the
+        // advertised sensor range while leaving enough room for temperature and battery variance.
+        if (batteryVolts !in 1.5..4.0 ||
+            temperatureC !in -40..125 ||
+            pressurePsi !in 0.0..190.0
+        ) return null
+
+        return TpmsDecodedReading(
+            protocol = TpmsProtocol.BR_27A5,
+            pressureBar = ((pressurePsi * PSI_TO_BAR) * 1000.0).roundToInt() / 1000.0,
+            pressurePsi = pressurePsi,
+            temperatureC = temperatureC,
+            batteryVolts = batteryVolts,
+            status = status,
+        )
+    }
+
+    /**
+     * Identifies only advertisements that carry a protocol signature we can explain. In
+     * particular, do not treat a strong generic manufacturer packet as a TPMS sensor: crowded
+     * places contain many of those, and presenting them makes an activation-first setup useless.
+     */
+    fun pairingIdentity(parsed: ParsedBleAdvertisement): TpmsPairingIdentity? {
+        decode(parsed)?.let { reading ->
+            return TpmsPairingIdentity(protocol = reading.protocol)
+        }
+
+        motorCareIdentity(parsed)?.let { return it }
+
+        // A malformed BR packet should remain discoverable for a later protocol capture, but the
+        // service UUID is still an explicit family signature rather than a proximity guess.
+        return if (BR_SERVICE_UUID in parsed.serviceUuids16) {
+            TpmsPairingIdentity(protocol = TpmsProtocol.BR_27A5)
+        } else {
+            null
+        }
+    }
+
+    fun isLikelyTpms(parsed: ParsedBleAdvertisement, @Suppress("UNUSED_PARAMETER") rssi: Int): Boolean =
+        pairingIdentity(parsed) != null
+
+    /**
+     * Static inspection of MotorCare 1.3.0 shows its automatic binding screen accepts only an
+     * exact TPMS1/TPMS_1 or TPMS2/TPMS_2 name plus a matching six-hex-digit identifier embedded
+     * in its advertisement. The first marker selects the front (80) or rear (81) slot.
+     *
+     * This is deliberately an identity decoder, not a pressure decoder: actual field packets are
+     * still required before displaying or alerting on MotorCare readings.
+     */
+    private fun motorCareIdentity(parsed: ParsedBleAdvertisement): TpmsPairingIdentity? {
+        val name = parsed.advertisedName?.uppercase() ?: return null
+        val expected = when {
+            name.startsWith("TPMS1") || name.startsWith("TPMS_1") ->
+                MOTORCARE_FRONT_FRAME_TYPE to TirePosition.FRONT
+            name.startsWith("TPMS2") || name.startsWith("TPMS_2") ->
+                MOTORCARE_REAR_FRAME_TYPE to TirePosition.REAR
+            else -> return null
+        }
+
+        val raw = parsed.rawHex
+        if (raw.length < MOTORCARE_SENSOR_ID_OFFSET + MOTORCARE_SENSOR_ID_LENGTH) return null
+        val frameType = raw.substring(
+            MOTORCARE_FRAME_TYPE_OFFSET,
+            MOTORCARE_FRAME_TYPE_OFFSET + 2,
+        ).toIntOrNull() ?: return null
+        if (frameType != expected.first) return null
+
+        val sensorId = raw.substring(
+            MOTORCARE_SENSOR_ID_OFFSET,
+            MOTORCARE_SENSOR_ID_OFFSET + MOTORCARE_SENSOR_ID_LENGTH,
+        ).uppercase()
+        if (!sensorId.all { it in '0'..'9' || it in 'A'..'F' } || !name.contains(sensorId)) {
+            return null
+        }
+
+        return TpmsPairingIdentity(
+            protocol = TpmsProtocol.MOTORCARE_TPMS,
+            sensorId = sensorId,
+            indicatedPosition = expected.second,
+        )
+    }
+
+    private fun ByteArray.toHex(): String = joinToString(separator = "") {
+        "%02X".format(it.toInt() and 0xFF)
+    }
+}
diff --git a/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAlertEvaluator.kt b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAlertEvaluator.kt
