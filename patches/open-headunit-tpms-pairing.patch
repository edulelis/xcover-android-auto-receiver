+package com.andrerinas.openheadunit.main
+
+import android.content.res.ColorStateList
+import android.graphics.Color
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import androidx.recyclerview.widget.DiffUtil
+import androidx.recyclerview.widget.ListAdapter
+import androidx.recyclerview.widget.RecyclerView
+import com.andrerinas.openheadunit.R
+import com.andrerinas.openheadunit.tpms.TirePosition
+import com.andrerinas.openheadunit.tpms.TpmsAssignments
+import com.andrerinas.openheadunit.tpms.TpmsCandidate
+import com.google.android.material.button.MaterialButton
+
+class TpmsCandidateAdapter(
+    private val onAssign: (TpmsCandidate) -> Unit,
+) : ListAdapter<TpmsCandidate, TpmsCandidateAdapter.ViewHolder>(CandidateDiff) {
+    private var assignments = TpmsAssignments()
+    private var target: TirePosition? = null
+
+    fun submit(
+        candidates: List<TpmsCandidate>,
+        assignments: TpmsAssignments,
+        target: TirePosition?,
+    ) {
+        this.assignments = assignments
+        this.target = target
+        // The repository preserves discovery order. Diffing prevents an RSSI refresh from
+        // resetting a focused item or making a captured sensor appear to jump around.
+        submitList(candidates)
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ViewHolder {
+        val view = LayoutInflater.from(parent.context)
+            .inflate(R.layout.item_tpms_candidate, parent, false)
+        return ViewHolder(view)
+    }
+
+    override fun onBindViewHolder(holder: ViewHolder, position: Int) {
+        holder.bind(getItem(position), assignments, target)
+    }
+
+    inner class ViewHolder(view: View) : RecyclerView.ViewHolder(view) {
+        private val title: TextView = view.findViewById(R.id.tpms_candidate_title)
+        private val detail: TextView = view.findViewById(R.id.tpms_candidate_detail)
+        private val useCandidate: MaterialButton = view.findViewById(R.id.tpms_use_candidate)
+
+        fun bind(
+            candidate: TpmsCandidate,
+            assignments: TpmsAssignments,
+            target: TirePosition?,
+        ) {
+            val context = itemView.context
+            val shortId = candidate.deviceId.filter(Char::isLetterOrDigit).takeLast(4).uppercase()
+            title.text = context.getString(
+                if (candidate.reading != null) {
+                    R.string.tpms_candidate_name
+                } else {
+                    R.string.tpms_candidate_detected
+                },
+                shortId,
+            )
+
+            val signal = context.getString(
+                when {
+                    candidate.rssi >= -65 -> R.string.tpms_signal_strong
+                    candidate.rssi >= -80 -> R.string.tpms_signal_medium
+                    else -> R.string.tpms_signal_weak
+                }
+            )
+            val reading = candidate.reading?.decoded
+            detail.text = if (reading != null) {
+                context.getString(
+                    R.string.tpms_candidate_known,
+                    reading.pressurePsi,
+                    reading.temperatureC,
+                    signal,
+                )
+            } else {
+                context.getString(R.string.tpms_candidate_unknown, signal)
+            }
+
+            val assignedPosition = assignments.positionFor(candidate.deviceId)
+            val isCurrentTargetSensor = target != null && assignedPosition == target
+            val isUsedByOtherWheel = assignedPosition != null && assignedPosition != target
+            val enabled = target != null && !isCurrentTargetSensor && !isUsedByOtherWheel
+
+            useCandidate.isEnabled = enabled
+            useCandidate.text = context.getString(
+                when {
+                    isCurrentTargetSensor -> R.string.tpms_current_sensor
+                    assignedPosition == TirePosition.FRONT -> R.string.tpms_used_front
+                    assignedPosition == TirePosition.REAR -> R.string.tpms_used_rear
+                    else -> R.string.tpms_use_this
+                }
+            )
+            useCandidate.contentDescription = when {
+                isCurrentTargetSensor -> "${useCandidate.text}. $shortId"
+                isUsedByOtherWheel -> "${useCandidate.text}. $shortId"
+                target == TirePosition.FRONT -> context.getString(
+                    R.string.tpms_use_front_accessibility,
+                    shortId,
+                )
+                else -> context.getString(R.string.tpms_use_rear_accessibility, shortId)
+            }
+            styleButton(useCandidate, enabled)
+            useCandidate.setOnClickListener { if (enabled) onAssign(candidate) }
+        }
+
+        private fun styleButton(button: MaterialButton, enabled: Boolean) {
+            val context = button.context
+            if (enabled) {
+                button.backgroundTintList = ColorStateList.valueOf(
+                    ContextCompat.getColor(context, R.color.tracer_accent)
+                )
+                button.setTextColor(Color.WHITE)
+                button.strokeWidth = 0
+            } else {
+                button.backgroundTintList = ColorStateList.valueOf(0xFF15171A.toInt())
+                button.setTextColor(ContextCompat.getColor(context, R.color.tracer_text_muted))
+                button.strokeColor = ColorStateList.valueOf(0xFF5D6B4A.toInt())
+                button.strokeWidth = context.resources.displayMetrics.density.toInt().coerceAtLeast(1)
+            }
+        }
+    }
+
+    private object CandidateDiff : DiffUtil.ItemCallback<TpmsCandidate>() {
+        override fun areItemsTheSame(oldItem: TpmsCandidate, newItem: TpmsCandidate): Boolean =
+            oldItem.deviceId == newItem.deviceId
+
+        override fun areContentsTheSame(oldItem: TpmsCandidate, newItem: TpmsCandidate): Boolean =
+            oldItem == newItem
+    }
+}
