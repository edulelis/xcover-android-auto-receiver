@@ -0,0 +1,45 @@
+package com.andrerinas.openheadunit.main
+
+import android.view.KeyEvent
+import com.andrerinas.openheadunit.utils.AppLog
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Process-local touch lock controlled by the XCover programmable side key.
+ *
+ * The state is deliberately not persisted. A process restart or crash therefore always returns
+ * the device to an unlocked screen instead of risking an input lockout.
+ */
+object TouchLockController {
+    const val HARDWARE_KEY_CODE = 1015
+
+    private val _locked = MutableStateFlow(false)
+    val locked = _locked.asStateFlow()
+
+    fun handleKeyEvent(event: KeyEvent): Boolean {
+        val wasLocked = _locked.value
+        val consumed = handleKeyEvent(event.keyCode, event.action)
+
+        if (consumed && event.action == KeyEvent.ACTION_UP && wasLocked != _locked.value) {
+            AppLog.i("TouchLock: ${if (_locked.value) "locked" else "unlocked"} by hardware key")
+        }
+
+        return consumed
+    }
+
+    internal fun handleKeyEvent(keyCode: Int, action: Int): Boolean {
+        if (keyCode != HARDWARE_KEY_CODE) return false
+        if (action != KeyEvent.ACTION_DOWN && action != KeyEvent.ACTION_UP) return false
+
+        // Toggle on release so a long press and its repeated DOWN events can change state only once.
+        if (action == KeyEvent.ACTION_UP) {
+            _locked.value = !_locked.value
+        }
+        return true
+    }
+
+    internal fun resetForTest() {
+        _locked.value = false
+    }
+}
