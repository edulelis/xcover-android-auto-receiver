@@ -0,0 +1,100 @@
+package com.andrerinas.openheadunit.tpms
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TpmsAlertEvaluatorTest {
+    private val now = 700_000L
+
+    @Test
+    fun `critical low pressure produces a front tire alert`() {
+        val alert = TpmsAlertEvaluator.evaluate(
+            state = TpmsState(frontReading = reading("front", pressureBar = 1.2, temperatureC = 34)),
+            nowElapsedMs = now,
+        )
+
+        requireNotNull(alert)
+        assertEquals(TirePosition.FRONT, alert.position)
+        assertEquals(TpmsAlertKind.LOW_PRESSURE, alert.kind)
+        assertEquals("FRONT:LOW_PRESSURE", alert.acknowledgementKey)
+        assertFalse(alert.isSimulation)
+    }
+
+    @Test
+    fun `critical temperature produces a rear tire alert`() {
+        val alert = TpmsAlertEvaluator.evaluate(
+            state = TpmsState(rearReading = reading("rear", pressureBar = 2.9, temperatureC = 82)),
+            nowElapsedMs = now,
+        )
+
+        requireNotNull(alert)
+        assertEquals(TirePosition.REAR, alert.position)
+        assertEquals(TpmsAlertKind.HIGH_TEMPERATURE, alert.kind)
+    }
+
+    @Test
+    fun `both critical tires remain available for sequential acknowledgement`() {
+        val alerts = TpmsAlertEvaluator.evaluateAll(
+            state = TpmsState(
+                frontReading = reading("front", pressureBar = 1.4, temperatureC = 32),
+                rearReading = reading("rear", pressureBar = 3.8, temperatureC = 40),
+            ),
+            nowElapsedMs = now,
+        )
+
+        assertEquals(
+            listOf("FRONT:LOW_PRESSURE", "REAR:HIGH_PRESSURE"),
+            alerts.map(TpmsAlert::acknowledgementKey),
+        )
+    }
+
+    @Test
+    fun `normal and stale readings do not produce alerts`() {
+        val normal = TpmsState(
+            frontReading = reading("front", pressureBar = 2.5, temperatureC = 42),
+            rearReading = reading("rear", pressureBar = 2.9, temperatureC = 46),
+        )
+        assertNull(TpmsAlertEvaluator.evaluate(normal, nowElapsedMs = now))
+
+        val stale = TpmsState(
+            frontReading = reading(
+                "front",
+                pressureBar = 1.0,
+                temperatureC = 30,
+                receivedAtElapsedMs = now - TPMS_READING_STALE_AFTER_MS - 1,
+            ),
+        )
+        assertNull(TpmsAlertEvaluator.evaluate(stale, nowElapsedMs = now))
+    }
+
+    @Test
+    fun `simulation is unmistakable and does not use a physical sensor`() {
+        val alert = TpmsAlert.simulatedCriticalLowPressure()
+
+        assertTrue(alert.isSimulation)
+        assertEquals(17.4, alert.pressurePsi, 0.001)
+        assertEquals(TpmsAlertKind.LOW_PRESSURE, alert.kind)
+    }
+
+    private fun reading(
+        deviceId: String,
+        pressureBar: Double,
+        temperatureC: Int,
+        receivedAtElapsedMs: Long = now,
+    ) = TpmsReading(
+        deviceId = deviceId,
+        decoded = TpmsDecodedReading(
+            protocol = TpmsProtocol.BR_27A5,
+            pressureBar = pressureBar,
+            pressurePsi = pressureBar * 14.5038,
+            temperatureC = temperatureC,
+            batteryVolts = 2.9,
+            status = 0,
+        ),
+        rssi = -48,
+        receivedAtElapsedMs = receivedAtElapsedMs,
+    )
+}
