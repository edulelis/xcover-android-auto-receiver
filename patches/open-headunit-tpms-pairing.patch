@@ -0,0 +1,67 @@
+package com.andrerinas.openheadunit.main
+
+import android.view.KeyEvent
+import org.junit.After
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+
+class TouchLockControllerTest {
+    @Before
+    fun setUp() {
+        TouchLockController.resetForTest()
+    }
+
+    @After
+    fun tearDown() {
+        TouchLockController.resetForTest()
+    }
+
+    @Test
+    fun `captured XCover key toggles only once when released`() {
+        assertFalse(TouchLockController.locked.value)
+
+        assertTrue(
+            TouchLockController.handleKeyEvent(
+                TouchLockController.HARDWARE_KEY_CODE,
+                KeyEvent.ACTION_DOWN,
+            ),
+        )
+        assertFalse(TouchLockController.locked.value)
+
+        assertTrue(
+            TouchLockController.handleKeyEvent(
+                TouchLockController.HARDWARE_KEY_CODE,
+                KeyEvent.ACTION_UP,
+            ),
+        )
+        assertTrue(TouchLockController.locked.value)
+
+        TouchLockController.handleKeyEvent(
+            TouchLockController.HARDWARE_KEY_CODE,
+            KeyEvent.ACTION_DOWN,
+        )
+        TouchLockController.handleKeyEvent(
+            TouchLockController.HARDWARE_KEY_CODE,
+            KeyEvent.ACTION_UP,
+        )
+        assertFalse(TouchLockController.locked.value)
+    }
+
+    @Test
+    fun `unrelated hardware keys remain available to their existing handlers`() {
+        assertFalse(
+            TouchLockController.handleKeyEvent(
+                KeyEvent.KEYCODE_VOLUME_UP,
+                KeyEvent.ACTION_UP,
+            ),
+        )
+        assertFalse(TouchLockController.locked.value)
+    }
+
+    @Test
+    fun `captured device key code remains the verified 1015`() {
+        assertTrue(TouchLockController.HARDWARE_KEY_CODE == 1015)
+    }
+}
