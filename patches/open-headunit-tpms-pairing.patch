@@ -0,0 +1,65 @@
+package com.andrerinas.openheadunit.tpms
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TpmsAssignmentsTest {
+    @Test
+    fun `a reading becomes stale after ten minutes`() {
+        val receivedAt = 1_000L
+
+        assertEquals(true, isTpmsReadingFresh(receivedAt, receivedAt + 600_000L))
+        assertEquals(false, isTpmsReadingFresh(receivedAt, receivedAt + 600_001L))
+        assertEquals(false, isTpmsReadingFresh(receivedAt, receivedAt - 1L))
+    }
+
+    @Test
+    fun `moving a physical sensor to another wheel clears the old assignment`() {
+        val initial = TpmsAssignments(frontDeviceId = "sensor-a", rearDeviceId = "sensor-b")
+
+        val moved = initial.assign(TirePosition.REAR, "sensor-a")
+
+        assertNull(moved.frontDeviceId)
+        assertEquals("sensor-a", moved.rearDeviceId)
+    }
+
+    @Test
+    fun `clearing one wheel preserves the other`() {
+        val initial = TpmsAssignments(frontDeviceId = "sensor-a", rearDeviceId = "sensor-b")
+
+        val cleared = initial.clear(TirePosition.FRONT)
+
+        assertNull(cleared.frontDeviceId)
+        assertEquals("sensor-b", cleared.rearDeviceId)
+    }
+
+    @Test
+    fun `guided setup always chooses the first missing wheel`() {
+        assertEquals(TirePosition.FRONT, TpmsAssignments().firstMissingPosition())
+        assertEquals(
+            TirePosition.REAR,
+            TpmsAssignments(frontDeviceId = "sensor-a").firstMissingPosition(),
+        )
+        assertNull(
+            TpmsAssignments(
+                frontDeviceId = "sensor-a",
+                rearDeviceId = "sensor-b",
+            ).firstMissingPosition()
+        )
+    }
+
+    @Test
+    fun `assignment reports position and completion without duplicate ids`() {
+        val partial = TpmsAssignments(frontDeviceId = "sensor-a")
+        assertEquals(TirePosition.FRONT, partial.positionFor("sensor-a"))
+        assertNull(partial.positionFor("sensor-b"))
+        assertFalse(partial.isComplete)
+
+        val complete = partial.assign(TirePosition.REAR, "sensor-b")
+        assertTrue(complete.isComplete)
+        assertEquals(TirePosition.REAR, complete.positionFor("sensor-b"))
+    }
+}
