index 0000000000000000000000000000000000000000..cfb7b798447291af90a2984f7ef9c412cc26945d
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsAlertEvaluator.kt
@@ -0,0 +1,92 @@
+package com.andrerinas.openheadunit.tpms
+
+data class TpmsAlertThresholds(
+    val criticalLowPressureBar: Double = 1.8,
+    val criticalHighPressureBar: Double = 3.6,
+    val criticalTemperatureC: Int = 80,
+)
+
+enum class TpmsAlertKind {
+    LOW_PRESSURE,
+    HIGH_PRESSURE,
+    HIGH_TEMPERATURE,
+}
+
+data class TpmsAlert(
+    val position: TirePosition,
+    val kind: TpmsAlertKind,
+    val pressurePsi: Double,
+    val temperatureC: Int,
+    val isSimulation: Boolean = false,
+) {
+    /** Stable while one unsafe condition remains active, so repeated BLE packets do not nag. */
+    val acknowledgementKey: String
+        get() = "${position.name}:${kind.name}"
+
+    companion object {
+        fun simulatedCriticalLowPressure() = TpmsAlert(
+            position = TirePosition.FRONT,
+            kind = TpmsAlertKind.LOW_PRESSURE,
+            pressurePsi = 17.4,
+            temperatureC = 34,
+            isSimulation = true,
+        )
+    }
+}
+
+object TpmsAlertEvaluator {
+    fun evaluate(
+        state: TpmsState,
+        nowElapsedMs: Long,
+        thresholds: TpmsAlertThresholds = TpmsAlertThresholds(),
+    ): TpmsAlert? = evaluateAll(state, nowElapsedMs, thresholds).firstOrNull()
+
+    fun evaluateAll(
+        state: TpmsState,
+        nowElapsedMs: Long,
+        thresholds: TpmsAlertThresholds = TpmsAlertThresholds(),
+    ): List<TpmsAlert> {
+        val readings = listOf(
+            TirePosition.FRONT to state.frontReading,
+            TirePosition.REAR to state.rearReading,
+        )
+
+        return readings.mapNotNull { (position, reading) ->
+            reading
+                ?.takeIf {
+                    isTpmsReadingFresh(
+                        receivedAtElapsedMs = it.receivedAtElapsedMs,
+                        nowElapsedMs = nowElapsedMs,
+                    )
+                }
+                ?.let { evaluateReading(position, it, thresholds) }
+        }
+    }
+
+    private fun evaluateReading(
+        position: TirePosition,
+        reading: TpmsReading,
+        thresholds: TpmsAlertThresholds,
+    ): TpmsAlert? {
+        val decoded = reading.decoded
+        val kind = when {
+            decoded.pressureBar <= thresholds.criticalLowPressureBar ->
+                TpmsAlertKind.LOW_PRESSURE
+
+            decoded.temperatureC >= thresholds.criticalTemperatureC ->
+                TpmsAlertKind.HIGH_TEMPERATURE
+
+            decoded.pressureBar >= thresholds.criticalHighPressureBar ->
+                TpmsAlertKind.HIGH_PRESSURE
+
+            else -> null
+        } ?: return null
+
+        return TpmsAlert(
+            position = position,
+            kind = kind,
+            pressurePsi = decoded.pressurePsi,
+            temperatureC = decoded.temperatureC,
+        )
+    }
+}
diff --git a/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsModels.kt b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsModels.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c564f4dcf401967dbc38fee65d0fdd6f8923d82c
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsModels.kt
@@ -0,0 +1,126 @@
+package com.andrerinas.openheadunit.tpms
+
+const val TPMS_READING_STALE_AFTER_MS = 10 * 60 * 1000L
+
+fun isTpmsReadingFresh(
+    receivedAtElapsedMs: Long,
+    nowElapsedMs: Long,
+    staleAfterMs: Long = TPMS_READING_STALE_AFTER_MS,
+): Boolean = nowElapsedMs >= receivedAtElapsedMs &&
+    nowElapsedMs - receivedAtElapsedMs <= staleAfterMs
+
+enum class TirePosition {
+    FRONT,
+    REAR,
+}
+
+enum class TpmsProtocol {
+    BR_27A5,
+    MOTORCARE_TPMS,
+    UNKNOWN,
+}
+
+enum class TpmsScanError {
+    PERMISSION_REQUIRED,
+    BLUETOOTH_DISABLED,
+    BLE_UNSUPPORTED,
+    SCAN_FAILED,
+}
+
+data class TpmsDecodedReading(
+    val protocol: TpmsProtocol,
+    val pressureBar: Double,
+    val pressurePsi: Double,
+    val temperatureC: Int,
+    val batteryVolts: Double?,
+    val status: Int,
+)
+
+/**
+ * A stable identity recovered from an advertisement without creating an Android Bluetooth bond.
+ * Some sensor families expose a sensor serial in their advertising name and payload; keeping that
+ * identifier is more robust than treating the transport address as the user's pairing choice.
+ */
+data class TpmsPairingIdentity(
+    val protocol: TpmsProtocol,
+    val sensorId: String? = null,
+    val indicatedPosition: TirePosition? = null,
+)
+
+data class TpmsReading(
+    val deviceId: String,
+    val decoded: TpmsDecodedReading,
+    val rssi: Int,
+    val receivedAtElapsedMs: Long,
+)
+
+data class TpmsCandidate(
+    val deviceId: String,
+    val advertisedName: String?,
+    val detectedProtocol: TpmsProtocol,
+    val indicatedPosition: TirePosition?,
+    val serviceUuids: Set<Int>,
+    val manufacturerDataLengths: List<Int>,
+    val rssi: Int,
+    val observationCount: Int,
+    val rawAdvertisementHex: String,
+    val reading: TpmsReading?,
+) {
+    val protocol: TpmsProtocol
+        get() = reading?.decoded?.protocol ?: detectedProtocol
+}
+
+data class TpmsAssignments(
+    val frontDeviceId: String? = null,
+    val rearDeviceId: String? = null,
+) {
+    fun deviceIdFor(position: TirePosition): String? = when (position) {
+        TirePosition.FRONT -> frontDeviceId
+        TirePosition.REAR -> rearDeviceId
+    }
+
+    /** A physical sensor can only represent one wheel at a time. */
+    fun assign(position: TirePosition, deviceId: String): TpmsAssignments = when (position) {
+        TirePosition.FRONT -> copy(
+            frontDeviceId = deviceId,
+            rearDeviceId = rearDeviceId.takeUnless { it == deviceId },
+        )
+
+        TirePosition.REAR -> copy(
+            frontDeviceId = frontDeviceId.takeUnless { it == deviceId },
+            rearDeviceId = deviceId,
+        )
+    }
+
+    fun clear(position: TirePosition): TpmsAssignments = when (position) {
+        TirePosition.FRONT -> copy(frontDeviceId = null)
+        TirePosition.REAR -> copy(rearDeviceId = null)
+    }
+
+    fun positionFor(deviceId: String): TirePosition? = when (deviceId) {
+        frontDeviceId -> TirePosition.FRONT
+        rearDeviceId -> TirePosition.REAR
+        else -> null
+    }
+
+    fun firstMissingPosition(): TirePosition? = when {
+        frontDeviceId == null -> TirePosition.FRONT
+        rearDeviceId == null -> TirePosition.REAR
+        else -> null
+    }
+
+    val isEmpty: Boolean
+        get() = frontDeviceId == null && rearDeviceId == null
+
+    val isComplete: Boolean
+        get() = frontDeviceId != null && rearDeviceId != null
+}
+
+data class TpmsState(
+    val scanning: Boolean = false,
+    val scanError: TpmsScanError? = null,
+    val assignments: TpmsAssignments = TpmsAssignments(),
+    val candidates: List<TpmsCandidate> = emptyList(),
+    val frontReading: TpmsReading? = null,
+    val rearReading: TpmsReading? = null,
+)
diff --git a/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsRepository.kt b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsRepository.kt
new file mode 100644
index 0000000000000000000000000000000000000000..15b31cfacc250089c20c1837b0316c7aafc0db91
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/tpms/TpmsRepository.kt
@@ -0,0 +1,256 @@
+package com.andrerinas.openheadunit.tpms
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.bluetooth.BluetoothAdapter
+import android.bluetooth.BluetoothManager
+import android.bluetooth.le.ScanCallback
+import android.bluetooth.le.ScanResult
+import android.bluetooth.le.ScanSettings
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import androidx.core.content.ContextCompat
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+class TpmsRepository(context: Context) {
+    private val appContext = context.applicationContext
+    // AppComponent is initialized during LOCKED_BOOT_COMPLETED. Keep the two non-sensitive sensor
+    // identifiers in device-protected storage so TPMS construction cannot touch credential-
+    // encrypted storage before Android reports the user as unlocked.
+    private val storageContext = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+        appContext.createDeviceProtectedStorageContext()
+    } else {
+        appContext
+    }
+    private val preferences = storageContext.getSharedPreferences(
+        PREFERENCES_NAME,
+        Context.MODE_PRIVATE,
+    )
+    private val candidatesById = linkedMapOf<String, TpmsCandidate>()
+    private val readingsById = linkedMapOf<String, TpmsReading>()
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private val _state = MutableStateFlow(
+        TpmsState(assignments = loadAssignments())
+    )
+    val state: StateFlow<TpmsState> = _state.asStateFlow()
+
+    private var activeScanMode: Int? = null
+    private var activePairingTarget: TirePosition? = null
+    private var pairingScanTimeout: Runnable? = null
+
+    private val scanCallback = object : ScanCallback() {
+        override fun onScanResult(callbackType: Int, result: ScanResult) {
+            acceptResult(result)
+        }
+
+        override fun onBatchScanResults(results: MutableList<ScanResult>) {
+            results.forEach(::acceptResult)
+        }
+
+        override fun onScanFailed(errorCode: Int) {
+            cancelPairingTimeout()
+            activeScanMode = null
+            activePairingTarget = null
+            publish(scanning = false, error = TpmsScanError.SCAN_FAILED)
+        }
+    }
+
+    fun requiredPermissions(): Array<String> = when {
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.S -> arrayOf(
+            Manifest.permission.BLUETOOTH_SCAN,
+            Manifest.permission.BLUETOOTH_CONNECT,
+        )
+
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.M -> arrayOf(
+            Manifest.permission.ACCESS_FINE_LOCATION,
+        )
+
+        else -> emptyArray()
+    }
+
+    fun hasScanPermission(): Boolean = requiredPermissions().all {
+        ContextCompat.checkSelfPermission(appContext, it) == PackageManager.PERMISSION_GRANTED
+    }
+
+    @SuppressLint("MissingPermission")
+    fun startScan(pairingMode: Boolean, pairingTarget: TirePosition? = null) {
+        if (!hasScanPermission()) {
+            publish(scanning = false, error = TpmsScanError.PERMISSION_REQUIRED)
+            return
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.LOLLIPOP) {
+            publish(scanning = false, error = TpmsScanError.BLE_UNSUPPORTED)
+            return
+        }
+
+        val manager = appContext.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager
+        val adapter: BluetoothAdapter = manager?.adapter ?: run {
+            publish(scanning = false, error = TpmsScanError.BLE_UNSUPPORTED)
+            return
+        }
+        if (!adapter.isEnabled) {
+            publish(scanning = false, error = TpmsScanError.BLUETOOTH_DISABLED)
+            return
+        }
+
+        val desiredMode = if (pairingMode) {
+            ScanSettings.SCAN_MODE_LOW_LATENCY
+        } else {
+            ScanSettings.SCAN_MODE_LOW_POWER
+        }
+        if (activeScanMode == desiredMode) return
+
+        if (activeScanMode != null) {
+            adapter.bluetoothLeScanner?.stopScan(scanCallback)
+        }
+        val scanner = adapter.bluetoothLeScanner ?: run {
+            publish(scanning = false, error = TpmsScanError.BLE_UNSUPPORTED)
+            return
+        }
+        val settings = ScanSettings.Builder()
+            .setScanMode(desiredMode)
+            .setReportDelay(0L)
+            .build()
+
+        candidatesById.clear()
+        activePairingTarget = pairingTarget.takeIf { pairingMode }
+        scanner.startScan(emptyList(), settings, scanCallback)
+        activeScanMode = desiredMode
+        if (pairingMode) {
+            schedulePairingTimeout()
+        } else {
+            cancelPairingTimeout()
+        }
+        publish(scanning = true, error = null)
+    }
+
+    @SuppressLint("MissingPermission")
+    fun stopScan() {
+        cancelPairingTimeout()
+        if (activeScanMode == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.LOLLIPOP) {
+            activePairingTarget = null
+            return
+        }
+        val manager = appContext.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager
+        if (hasScanPermission()) {
+            manager?.adapter?.bluetoothLeScanner?.stopScan(scanCallback)
+        }
+        activeScanMode = null
+        activePairingTarget = null
+        publish(scanning = false, error = null)
+    }
+
+    fun assign(position: TirePosition, deviceId: String) {
+        val assignments = _state.value.assignments.assign(position, deviceId)
+        persist(assignments)
+        publish(assignments = assignments)
+    }
+
+    fun clear(position: TirePosition) {
+        val assignments = _state.value.assignments.clear(position)
+        persist(assignments)
+        publish(assignments = assignments)
+    }
+
+    /** Starts each wheel step with only discoveries made during that step. */
+    fun clearPairingCandidates() {
+        candidatesById.clear()
+        publish()
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun acceptResult(result: ScanResult) {
+        val raw = result.scanRecord?.bytes ?: return
+        val parsed = TpmsAdvertisementDecoder.parse(raw)
+        val identity = TpmsAdvertisementDecoder.pairingIdentity(parsed) ?: return
+        if (activePairingTarget != null &&
+            identity.indicatedPosition != null &&
+            identity.indicatedPosition != activePairingTarget
+        ) return
+
+        val deviceId = identity.sensorId ?: result.device.address ?: return
+        val decoded = TpmsAdvertisementDecoder.decode(parsed)
+        val reading = decoded?.let {
+            TpmsReading(
+                deviceId = deviceId,
+                decoded = it,
+                rssi = result.rssi,
+                receivedAtElapsedMs = SystemClock.elapsedRealtime(),
+            )
+        }
+        if (reading != null) readingsById[deviceId] = reading
+
+        val previous = candidatesById[deviceId]
+        if (previous == null && candidatesById.size >= MAX_CANDIDATES) return
+        candidatesById[deviceId] = TpmsCandidate(
+            deviceId = deviceId,
+            advertisedName = parsed.advertisedName,
+            detectedProtocol = identity.protocol,
+            indicatedPosition = identity.indicatedPosition,
+            serviceUuids = parsed.serviceUuids16,
+            manufacturerDataLengths = parsed.manufacturerData.map(ByteArray::size),
+            rssi = result.rssi,
+            observationCount = (previous?.observationCount ?: 0) + 1,
+            rawAdvertisementHex = parsed.rawHex,
+            reading = reading ?: readingsById[deviceId],
+        )
+        publish()
+    }
+
+    private fun publish(
+        scanning: Boolean = activeScanMode != null,
+        error: TpmsScanError? = _state.value.scanError,
+        assignments: TpmsAssignments = _state.value.assignments,
+    ) {
+        _state.value = TpmsState(
+            scanning = scanning,
+            scanError = error,
+            assignments = assignments,
+            // LinkedHashMap preserves discovery order. A candidate never jumps while its signal
+            // fluctuates, which is essential when the user is activating one sensor at a time.
+            candidates = candidatesById.values.toList(),
+            frontReading = assignments.frontDeviceId?.let(readingsById::get),
+            rearReading = assignments.rearDeviceId?.let(readingsById::get),
+        )
+    }
+
+    private fun loadAssignments(): TpmsAssignments = TpmsAssignments(
+        frontDeviceId = preferences.getString(KEY_FRONT_ID, null),
+        rearDeviceId = preferences.getString(KEY_REAR_ID, null),
+    )
+
+    private fun persist(assignments: TpmsAssignments) {
+        preferences.edit()
+            .putString(KEY_FRONT_ID, assignments.frontDeviceId)
+            .putString(KEY_REAR_ID, assignments.rearDeviceId)
+            .apply()
+    }
+
+    private fun schedulePairingTimeout() {
+        cancelPairingTimeout()
+        pairingScanTimeout = Runnable {
+            if (activeScanMode == ScanSettings.SCAN_MODE_LOW_LATENCY) stopScan()
+        }.also { mainHandler.postDelayed(it, PAIRING_SCAN_DURATION_MS) }
+    }
+
+    private fun cancelPairingTimeout() {
+        pairingScanTimeout?.let(mainHandler::removeCallbacks)
+        pairingScanTimeout = null
+    }
+
+    companion object {
+        private const val PREFERENCES_NAME = "tpms_pairing"
+        private const val KEY_FRONT_ID = "front_device_id"
+        private const val KEY_REAR_ID = "rear_device_id"
+        /** A short activation window should show only the few explicitly recognized sensors. */
+        private const val MAX_CANDIDATES = 3
+        private const val PAIRING_SCAN_DURATION_MS = 30_000L
+    }
+}
