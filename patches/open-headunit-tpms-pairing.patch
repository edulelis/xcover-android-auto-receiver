diff --git a/app/src/main/java/com/andrerinas/openheadunit/main/DeviceAppsActivity.kt b/app/src/main/java/com/andrerinas/openheadunit/main/DeviceAppsActivity.kt
new file mode 100644
index 0000000000000000000000000000000000000000..3fe99a4f714641ab270984f6786525bdc24bba1c
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/main/DeviceAppsActivity.kt
@@ -0,0 +1,217 @@
+package com.andrerinas.openheadunit.main
+
+import android.content.ActivityNotFoundException
+import android.content.ComponentName
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.content.res.Configuration
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.provider.Settings as AndroidSettings
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ImageView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.recyclerview.widget.GridLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.andrerinas.openheadunit.R
+import com.andrerinas.openheadunit.app.BaseActivity
+import com.andrerinas.openheadunit.utils.Settings
+import com.andrerinas.openheadunit.utils.SystemUI
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.card.MaterialCardView
+import java.text.Collator
+
+class DeviceAppsActivity : BaseActivity() {
+
+    private lateinit var adapter: DeviceAppsAdapter
+    private lateinit var recycler: RecyclerView
+    private lateinit var empty: TextView
+    private var lastLaunchAtMs = 0L
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        requestedOrientation = Settings(this).screenOrientation.androidOrientation
+        setContentView(R.layout.activity_device_apps)
+
+        val root = findViewById<View>(R.id.device_apps_root)
+        SystemUI.apply(window, root, Settings(this).fullscreenMode)
+
+        findViewById<MaterialButton>(R.id.device_apps_back).setOnClickListener { finish() }
+
+        recycler = findViewById(R.id.device_apps_list)
+        empty = findViewById(R.id.device_apps_empty)
+        adapter = DeviceAppsAdapter(::openApp)
+        recycler.layoutManager = GridLayoutManager(
+            this,
+            if (resources.configuration.orientation == Configuration.ORIENTATION_LANDSCAPE) 2 else 1,
+        )
+        recycler.adapter = adapter
+    }
+
+    override fun onResume() {
+        super.onResume()
+        refreshApps()
+    }
+
+    private fun refreshApps() {
+        val entries = loadLaunchableApps()
+        adapter.submitEntries(entries)
+        recycler.visibility = if (entries.isEmpty()) View.GONE else View.VISIBLE
+        empty.visibility = if (entries.isEmpty()) View.VISIBLE else View.GONE
+    }
+
+    private fun loadLaunchableApps(): List<DeviceAppEntry> {
+        val launcherIntent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
+        val resolved = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            packageManager.queryIntentActivities(
+                launcherIntent,
+                PackageManager.ResolveInfoFlags.of(0L),
+            )
+        } else {
+            @Suppress("DEPRECATION")
+            packageManager.queryIntentActivities(launcherIntent, 0)
+        }
+        val locale = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            resources.configuration.locales[0]
+        } else {
+            @Suppress("DEPRECATION")
+            resources.configuration.locale
+        }
+        val collator = Collator.getInstance(locale)
+
+        val launchableApps = resolved
+            .asSequence()
+            .filter { it.activityInfo.exported }
+            .filterNot { it.activityInfo.packageName == packageName }
+            .filterNot { it.activityInfo.packageName in EXCLUDED_PACKAGES }
+            .map { info ->
+                val component = ComponentName(info.activityInfo.packageName, info.activityInfo.name)
+                DeviceAppEntry(
+                    label = info.loadLabel(packageManager).toString(),
+                    component = component,
+                    icon = info.loadIcon(packageManager),
+                    launchIntent = Intent.makeMainActivity(component),
+                )
+            }
+            .sortedWith { first, second ->
+                val labelOrder = collator.compare(first.label, second.label)
+                if (labelOrder != 0) labelOrder else {
+                    first.component.flattenToString().compareTo(second.component.flattenToString())
+                }
+            }
+            .distinctBy { it.component.packageName }
+            .toList()
+
+        return listOf(loadSystemSettingsEntry()) + launchableApps
+    }
+
+    private fun loadSystemSettingsEntry(): DeviceAppEntry {
+        val settingsIntent = Intent(AndroidSettings.ACTION_SETTINGS)
+        val resolved = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            packageManager.resolveActivity(
+                settingsIntent,
+                PackageManager.ResolveInfoFlags.of(PackageManager.MATCH_DEFAULT_ONLY.toLong()),
+            )
+        } else {
+            @Suppress("DEPRECATION")
+            packageManager.resolveActivity(settingsIntent, PackageManager.MATCH_DEFAULT_ONLY)
+        }
+        val activityInfo = resolved?.activityInfo
+        val component = if (activityInfo != null) {
+            ComponentName(activityInfo.packageName, activityInfo.name)
+        } else {
+            ComponentName(ANDROID_SETTINGS_PACKAGE, ANDROID_SETTINGS_FALLBACK_ACTIVITY)
+        }
+        return DeviceAppEntry(
+            label = getString(R.string.system_settings),
+            component = component,
+            icon = activityInfo?.loadIcon(packageManager) ?: packageManager.defaultActivityIcon,
+            launchIntent = settingsIntent,
+        )
+    }
+
+    private fun openApp(entry: DeviceAppEntry) {
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastLaunchAtMs < LAUNCH_DEBOUNCE_MS) return
+        lastLaunchAtMs = now
+        try {
+            startActivity(Intent(entry.launchIntent))
+        } catch (_: ActivityNotFoundException) {
+            showOpenFailure(entry.label)
+        } catch (_: SecurityException) {
+            showOpenFailure(entry.label)
+        }
+    }
+
+    private fun showOpenFailure(label: String) {
+        Toast.makeText(
+            this,
+            getString(R.string.device_app_open_failed, label),
+            Toast.LENGTH_LONG,
+        ).show()
+        refreshApps()
+    }
+
+    companion object {
+        private const val LAUNCH_DEBOUNCE_MS = 600L
+        private const val ANDROID_SETTINGS_PACKAGE = "com.android.settings"
+        private const val ANDROID_SETTINGS_FALLBACK_ACTIVITY = "com.android.settings.Settings"
+        private val EXCLUDED_PACKAGES = setOf(
+            "com.sec.android.app.launcher",
+            "com.android.settings",
+            "com.andrerinas.headunitrevived",
+        )
+    }
+}
+
+private data class DeviceAppEntry(
+    val label: String,
+    val component: ComponentName,
+    val icon: Drawable,
+    val launchIntent: Intent,
+)
+
+private class DeviceAppsAdapter(
+    private val onOpen: (DeviceAppEntry) -> Unit,
+) : RecyclerView.Adapter<DeviceAppsAdapter.AppViewHolder>() {
+
+    private var entries: List<DeviceAppEntry> = emptyList()
+
+    fun submitEntries(newEntries: List<DeviceAppEntry>) {
+        entries = newEntries
+        notifyDataSetChanged()
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): AppViewHolder {
+        val view = LayoutInflater.from(parent.context)
+            .inflate(R.layout.item_device_app, parent, false)
+        return AppViewHolder(view)
+    }
+
+    override fun onBindViewHolder(holder: AppViewHolder, position: Int) {
+        holder.bind(entries[position])
+    }
+
+    override fun getItemCount(): Int = entries.size
+
+    inner class AppViewHolder(itemView: View) : RecyclerView.ViewHolder(itemView) {
+        private val card = itemView.findViewById<MaterialCardView>(R.id.device_app_card)
+        private val icon = itemView.findViewById<ImageView>(R.id.device_app_icon)
+        private val label = itemView.findViewById<TextView>(R.id.device_app_label)
+
+        fun bind(entry: DeviceAppEntry) {
+            icon.setImageDrawable(entry.icon)
+            label.text = entry.label
+            card.contentDescription = itemView.context.getString(
+                R.string.device_app_open_accessibility,
+                entry.label,
+            )
+            card.setOnClickListener { onOpen(entry) }
+        }
+    }
+}
