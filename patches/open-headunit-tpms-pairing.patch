diff --git a/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedCopyContractTest.kt b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedCopyContractTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e18278764171771f10c576bb38d4a3a9fea371f1
--- /dev/null
+++ b/app/src/test/java/com/andrerinas/headunitrevived/main/DedicatedCopyContractTest.kt
@@ -0,0 +1,105 @@
+package com.andrerinas.openheadunit.main
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DedicatedCopyContractTest {
+
+    @Test
+    fun `published UI copy avoids owner-specific labels`() {
+        val copy = File("src/main/res")
+            .walkTopDown()
+            .filter { it.isFile && it.name == "strings.xml" }
+            .joinToString("\n") { it.readText() }
+
+        listOf(
+            "owner's phone",
+            "owner phone",
+            "my phone",
+            "my motorcycle",
+            "primary phone",
+            "telefone principal",
+            "meu telefone",
+            "minha moto",
+            "intercom",
+        ).forEach { ownerSpecificTerm ->
+            assertFalse(
+                "UI copy must not contain owner-specific term: $ownerSpecificTerm",
+                copy.contains(ownerSpecificTerm, ignoreCase = true),
+            )
+        }
+
+        val buildConfig = File("build.gradle.kts").readText()
+        val appNames = Regex("""resValue\("string", "app_name", "([^"]+)"\)""")
+            .findAll(buildConfig)
+            .map { it.groupValues[1] }
+            .toList()
+        assertEquals(listOf("Open Headunit TPMS"), appNames)
+    }
+
+    @Test
+    fun `dedicated connection and audio states describe roles rather than hardware`() {
+        val english = File("src/main/res/values/strings.xml").readText()
+        val portuguese = File("src/main/res/values-pt-rBR/strings.xml").readText()
+
+        assertTrue(english.contains("<string name=\"dedicated_home_connect\">Connect</string>"))
+        assertTrue(english.contains("<string name=\"dedicated_home_return\">Return</string>"))
+        assertTrue(english.contains("<string name=\"dedicated_home_audio_receiver\">Played by this device</string>"))
+        assertTrue(portuguese.contains("<string name=\"dedicated_home_connect\">Conectar</string>"))
+        assertTrue(portuguese.contains("<string name=\"dedicated_home_return\">Voltar</string>"))
+        assertTrue(portuguese.contains("<string name=\"dedicated_home_audio_receiver\">Reprodução neste aparelho</string>"))
+        assertTrue(portuguese.contains("<string name=\"tpms_safety_note\">SOMENTE COM O VEÍCULO PARADO</string>"))
+        assertTrue(english.contains("<string name=\"receiver_settings_accessibility\">Open receiver settings</string>"))
+        assertTrue(portuguese.contains("<string name=\"receiver_settings_accessibility\">Abrir configurações do receptor</string>"))
+        assertTrue(english.contains("<string name=\"device_apps_empty\">No apps to show</string>"))
+        assertTrue(portuguese.contains("<string name=\"device_apps_empty\">Nenhum app para mostrar</string>"))
+        assertFalse(english.contains("device_surface_parked_message"))
+        assertFalse(portuguese.contains("device_surface_parked_message"))
+    }
+
+    @Test
+    fun `dedicated surfaces do not repeat the wireless qualifier`() {
+        val english = File("src/main/res/values/strings.xml").readText()
+        val portuguese = File("src/main/res/values-pt-rBR/strings.xml").readText()
+
+        assertTrue(english.contains("<string name=\"dedicated_home_subtitle_short\">ANDROID AUTO</string>"))
+        assertTrue(english.contains("<string name=\"dedicated_home_connecting\">Connecting…</string>"))
+        assertTrue(portuguese.contains("<string name=\"dedicated_home_subtitle_short\">ANDROID AUTO</string>"))
+        assertTrue(portuguese.contains("<string name=\"dedicated_home_connecting\">Conectando…</string>"))
+        assertFalse(english.contains("dedicated_home_connecting_badge"))
+        assertFalse(portuguese.contains("dedicated_home_connecting_badge"))
+        assertFalse(english.contains("dedicated_home_ready"))
+        assertFalse(portuguese.contains("dedicated_home_ready"))
+        assertFalse(english.contains("dedicated_home_ready_detail"))
+        assertFalse(portuguese.contains("dedicated_home_ready_detail"))
+        assertFalse(english.contains("<string name=\"dedicated_home_subtitle_short\">WIRELESS ANDROID AUTO</string>"))
+        assertFalse(portuguese.contains("ANDROID AUTO SEM FIO"))
+    }
