new file mode 100644
index 0000000000000000000000000000000000000000..f17852c42413a8160cd726d01748b91c30e188c3
--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/app/PowerConnectedReceiver.kt
@@ -0,0 +1,51 @@
+package com.andrerinas.openheadunit.app
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.PowerManager
+import androidx.core.content.ContextCompat
+import com.andrerinas.openheadunit.aap.AapService
+import com.andrerinas.openheadunit.utils.AppLog
+import com.andrerinas.openheadunit.utils.Settings
+
+/** Ignition-style entry point for a dedicated receiver device. */
+class PowerConnectedReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_POWER_CONNECTED) return
+        if (!Settings.isAutoStartOnPowerConnectedEnabled(context)) {
+            AppLog.i("PowerConnectedReceiver: power auto-start is disabled")
+            return
+        }
+
+        wakeDisplay(context)
+
+        try {
+            ContextCompat.startForegroundService(
+                context,
+                Intent(context, AapService::class.java).apply {
+                    action = AapService.ACTION_POWER_CONNECTED_START
+                },
+            )
+            AppLog.i("PowerConnectedReceiver: requested dedicated power start")
+        } catch (error: Exception) {
+            AppLog.e("PowerConnectedReceiver: failed to start receiver service", error)
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun wakeDisplay(context: Context) {
+        val powerManager = context.getSystemService(Context.POWER_SERVICE) as PowerManager
+        val wakeLock = powerManager.newWakeLock(
+            PowerManager.FULL_WAKE_LOCK or
+                PowerManager.ACQUIRE_CAUSES_WAKEUP or
+                PowerManager.ON_AFTER_RELEASE,
+            "HeadunitRevived:PowerConnected",
+        )
+        wakeLock.acquire(POWER_WAKE_TIMEOUT_MS)
+    }
+
+    private companion object {
+        const val POWER_WAKE_TIMEOUT_MS = 10_000L
+    }
+}
