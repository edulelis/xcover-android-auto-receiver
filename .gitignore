# macOS and editor state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local Android and Gradle state
.gradle/
**/build/
local.properties

# Local credentials and signing material
.env
.env.*
!.env.example
*.jks
*.keystore
